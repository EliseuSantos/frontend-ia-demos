{
  "name": "frontend-ia-demos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:streaming": "pnpm --filter @demos/streaming-ui dev",
    "dev:main-thread": "pnpm --filter @demos/main-thread dev",
    "dev:on-device": "pnpm --filter @demos/on-device-ai dev",
    "dev:resilient": "pnpm --filter @demos/resilient-ui dev",
    "typecheck": "pnpm -r --sort typecheck && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "onnxruntime-node", "protobufjs"]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
